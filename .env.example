# Value Steward mk II — environment template.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The fastest correct way to create it is to copy value-steward's, at the OS
# level, without opening the file:
#
#     cp /home/lukes/value-steward/.env /home/lukes/value-steward-2/.env
#
# Every variable below uses the same name VS1 uses, deliberately, so that copy
# is all that is needed — same paper account, same ntfy topic, one phone
# subscription covering both systems. VS1's .env carries extra variables VS2
# ignores; that is harmless.

# --- Alpaca (paper) ---------------------------------------------------------
# The same paper account VS1 used. Exactly one system may trade it — see
# DESIGN.md, "Account".
ALPACA_API_KEY_ID=your_api_key
ALPACA_SECRET_KEY=your_secret_key

# --- Push notifications (ntfy) ----------------------------------------------
# VS_NTFY_TOPIC is the secret: anyone holding it can read and publish to your
# feed. It is never logged and never committed. Leave it unset and pushes are
# silently off — fine on a dev box, wrong for a live run.
#
# Verify with:  .venv/bin/python -m vs2.push_test
VS_NTFY_TOPIC=
# The public server. VS1 uses this too; only change it for a self-hosted one.
VS_NTFY_SERVER=https://ntfy.sh
# Bearer token, only needed for a self-hosted server or a reserved topic.
# VS_NTFY_TOKEN=
# Master switch. Set false to mute every push without unsetting the topic.
VS_PUSH_ENABLED=true
